# 环境与密钥
.env
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 运行期数据
# SQLite 数据库（里面是错题本与各功能历史）。原先还有向量索引 / 克隆仓库 /
# 沙箱工作区 / 嵌入模型缓存四项，它们属于已删除的「开源贡献端」。
data/*.db

# 已删除的「本地项目库」目录：功能虽然删了，但**老用户机器上这个文件夹还在**
# （里面是学生自己的作业）。这一行必须留着 —— 删掉它的那次提交就把
# 开发者本地的作业文件一起提上去了（72KB 的 big.py 等 11 个文件），
# 是 .gitignore 在兜住真实数据，不是它在描述某个还在的功能。
data/library/

# 覆盖率与构建产物
.coverage
htmlcov/
coverage.xml
dist/
build/

# IDE
.idea/
.vscode/

# 本地工作文档（参赛材料草稿、随手记的测试文档等）：
# 默认不公开。想让某个文档进仓库，就把下面这行注释掉/删掉。
测试.docx
*.docx.bak

