# ---------------------------------------------------------------------------
# 应用配置（嵌套配置使用双下划线 __ 分隔，例如 APP__DEBUG）
# ---------------------------------------------------------------------------
APP__NAME=ai-code-tutor-agent
APP__VERSION=0.1.0
APP__ENVIRONMENT=local
APP__DEBUG=true
APP__HOST=127.0.0.1
APP__PORT=8000
APP__API_V1_PREFIX=/api/v1
APP__LOG_LEVEL=INFO
APP__CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP__TRACE_HEADER=X-Trace-Id

# ---------------------------------------------------------------------------
# 数据库：开发期 SQLite，生产期切 PostgreSQL
# 生产可改为：postgresql+asyncpg://user:password@host:5432/agent
# ---------------------------------------------------------------------------
DATABASE__SQLITE_PATH=./data/app.db
DATABASE__ECHO=false
DATABASE__URL_OVERRIDE=

# ---------------------------------------------------------------------------
# 大模型（OpenAI 兼容协议；开源代码模型优先，如 DeepSeek-Coder / CodeQwen）
# 任何兼容 /chat/completions 的服务都可以：vLLM / Ollama / LM Studio / 硅基流动 / 通义
#
# 用法：把本文件复制成 .env，再填入自己的 Key。
#   copy .env.example .env
#
# **这里必须留空**，原因有两个：
#   1. 本文件是要提交/分发的模板，写真实 Key 等于把密钥公开泄露；
#   2. 留占位符（如 sk-replace-me）会让服务误判为"已配置"，
#      前端显示"AI 已就绪"，真正调用时才以 401 失败，学生很难看懂。
# 空值时 /api/v1/tutor/check 等接口返回 503 并提示"请配置 LLM__API_KEY"，
# 这是有意设计的友好降级：项目库与代码分类等功能不受影响，照常可用。
# ---------------------------------------------------------------------------
# ===========================================================================
# 【重点】多模型配置：支持在网页上选模型 + 填自己的 API Key
# ---------------------------------------------------------------------------
# 写一组 LLM__MODELS__<ID>__*，网页的模型下拉框里就会多出一个选项。
#   <ID> 是模型标识，只能用小写字母/数字/下划线/连字符，例如 deepseek、qwen、ollama。
#
# 每个模型可以配这几项（**只有 MODEL_NAME 是必填的**）：
#   LABEL           网页上显示的名字（留空则显示模型名）
#   PROVIDER        提供商标识：deepseek / qwen / openai / ollama / vllm …
#                   写上它就能自动补出 API 地址，不必再填 BASE_URL
#   MODEL_NAME      真正发给服务商的模型名，如 deepseek-chat、qwen-plus
#   BASE_URL        自建/私有网关才需要填（留空按 PROVIDER 自动补）
#   API_KEY         这个模型的默认 Key（留空 = 用网页上输入的，或用全局兜底 Key）
#   API_KEY_ENV     也可以从别的环境变量读 Key，例如 DASHSCOPE_API_KEY
#   DESCRIPTION     给学生的说明文字（显示在网页上）
#   ENABLED         设成 false 可临时隐藏这个模型（不用删配置）
#
# 不想让这套配置生效？把下面每组都注释掉即可，
# 那样就退回"单模型"写法（用本段下面的 LLM__BASE_URL / LLM__MODEL）。
# ===========================================================================

# ---- 模型 1：DeepSeek（官方，性价比高，默认选它）----
LLM__MODELS__DEEPSEEK__LABEL=DeepSeek 官方
LLM__MODELS__DEEPSEEK__PROVIDER=deepseek
LLM__MODELS__DEEPSEEK__MODEL_NAME=deepseek-chat
LLM__MODELS__DEEPSEEK__DESCRIPTION=在 platform.deepseek.com 申请 Key，注册一般送额度
LLM__MODELS__DEEPSEEK__API_KEY=
# LLM__MODELS__DEEPSEEK__BASE_URL=https://api.deepseek.com/v1

# ---- 模型 2：通义千问 Qwen（阿里云百炼，OpenAI 兼容模式）----
LLM__MODELS__QWEN__LABEL=通义千问 Qwen
LLM__MODELS__QWEN__PROVIDER=qwen
LLM__MODELS__QWEN__MODEL_NAME=qwen-plus
LLM__MODELS__QWEN__DESCRIPTION=在 bailian.console.aliyun.com 申请 DashScope Key
LLM__MODELS__QWEN__API_KEY=
# 也可以让 Key 从别的环境变量读，避免同一条密钥写两处：
# LLM__MODELS__QWEN__API_KEY_ENV=DASHSCOPE_API_KEY
# LLM__MODELS__QWEN__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 模型 3：Ollama（本地跑，不需要 Key，断网也能演示）----
# 用法：先装 Ollama 并执行 `ollama pull qwen2.5-coder:7b`，保持 ollama serve 在跑。
LLM__MODELS__OLLAMA__LABEL=本地 Ollama（免 Key）
LLM__MODELS__OLLAMA__PROVIDER=ollama
LLM__MODELS__OLLAMA__MODEL_NAME=qwen2.5-coder:7b
LLM__MODELS__OLLAMA__DESCRIPTION=本地模型，不需要 API Key；需先 ollama pull 对应模型
# LLM__MODELS__OLLAMA__BASE_URL=http://127.0.0.1:11434/v1

# 默认用哪个模型（填上面的 <ID>）。留空 = 用第一个。
LLM__DEFAULT_MODEL=deepseek

# ---------------------------------------------------------------------------
# 单模型写法（旧配置，仍然完全兼容），有两个用途：
#   1. 一套多模型都没配时，这里就是唯一模型；
#   2. 配了多模型时，这里是"全局默认值"：多模型没写的超时 / max_tokens 从这里继承，
#      而 LLM__API_KEY 还兼任**兜底 Key**：某个云端模型没单独配 Key 时用它。
#      （本地模型不吃兜底 Key，免得把云端密钥发给本机服务）
# ---------------------------------------------------------------------------
LLM__PROVIDER=openai-compatible
# DeepSeek 官方端点；本地推理改成 http://127.0.0.1:8000/v1 之类
LLM__BASE_URL=https://api.deepseek.com/v1
LLM__API_KEY=
# 实测说明：DeepSeek 会把模型名统一路由到当前可用的主力模型
# （请求 deepseek-coder / deepseek-chat 都返回 model=deepseek-flash），
# 所以这里填任何一个 DeepSeek 官方模型名都能用；换别的服务商时按它的文档填。
LLM__MODEL=deepseek-chat
LLM__TIMEOUT_SECONDS=120
LLM__MAX_TOKENS=4096
LLM__TEMPERATURE=0.2
LLM__MAX_RETRIES=2
LLM__RETRY_BACKOFF_SECONDS=1.0

# ---------------------------------------------------------------------------
# 安全：网页上填的 API Key 怎么临时保管
#
# 背景：支持同学在网页上选模型、填自己的 Key。那些 Key 只放在**服务端内存**里，
# 不写数据库、不进日志，进程重启就没了（详见 app/core/api_key_manager.py）。
# 下面三项控制这份内存保管箱的行为。
# ---------------------------------------------------------------------------
# 多久没用就自动清除（秒）。默认 1800 = 30 分钟；每次使用都会顺延
SECURITY__API_KEY_TTL_SECONDS=1800
# 内存里最多同时保留多少个会话。set_key 是无需登录就能调的接口，
# 不设上限的话有人循环调用就能把内存吃满；超出后淘汰最久没用的会话
SECURITY__MAX_SESSIONS=500
# 是否允许前端传 Key。设成 false = 只能用上面 .env 里配好的 Key，
# 网页上的「填 Key」会被 403 拒绝（适合"统一由老师配 Key"的课堂场景）
SECURITY__ALLOW_CLIENT_KEY=true

# ---------------------------------------------------------------------------
# 说明：这里原先还有五块配置（已随功能删除，留着也不会生效）
#   RETRIEVAL__*    混合检索（BM25 + FAISS + 嵌入模型）
#   DOCKER__*       Docker 沙箱执行
#   REPOSITORY__*   仓库克隆与解析
#   LIBRARY__*      本地项目库（扫描 / 在线编辑 / 替换 / 删除）
#   CLASSIFIER__*   代码文件自动分类（按语言归档到 c/ java/ python/）
# 如果手上的 .env 是从旧版本复制的，那几行现在是**被忽略的**
# （Settings 配了 extra="ignore"），不会报错，可以直接删掉。
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Agent Trace
# ---------------------------------------------------------------------------
TRACING__ENABLED=true
TRACING__SINK=log
TRACING__CAPTURE_INPUT=true
TRACING__CAPTURE_OUTPUT=true
TRACING__MAX_PAYLOAD_CHARS=2000
TRACING__MEMORY_BUFFER_SIZE=1000


